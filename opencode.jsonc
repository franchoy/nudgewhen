{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/minimax-m3",
  "small_model": "minimax/minimax-m3",
  "enabled_providers": ["minimax","opencode-go"],
  "default_agent": "nudge-plan",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "*": "deny"
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  }
}
